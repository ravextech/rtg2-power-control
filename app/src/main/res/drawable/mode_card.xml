    <item android:state_focused="true"><shape><solid android:color="#26443F"/><corners android:radius="18dp"/><stroke android:width="3dp" android:color="#67E8C5"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#19332F"/><corners android:radius="18dp"/><stroke android:width="1dp" android:color="#438F7D"/></shape></item>
    <item><shape><solid android:color="#1A2735"/><corners android:radius="18dp"/><stroke android:width="1dp" android:color="#354457"/></shape></item>
